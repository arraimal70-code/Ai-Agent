# =============================================================================
#  Self-Learning SWE Agent  —  Environment Configuration
# =============================================================================

# ── NVIDIA NIM API (OpenAI-compatible endpoint) ───────────────────────────────
NVIDIA_API_KEY=nvapi-your-key-here

# LLM model — NVIDIA NIM catalog
#   meta/llama-3.3-70b-instruct         best quality
#   meta/llama-3.1-8b-instruct          fastest / cheapest
#   nvidia/llama-3.1-nemotron-70b-instruct  highest reasoning
NVIDIA_LLM_MODEL=meta/llama-3.1-8b-instruct

# ── Embedder — NVIDIA NIM ─────────────────────────────────────────────────────
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_EMBEDDING_DIMS=1024

# ── Qdrant vector store (Docker Compose) ──────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=swe_agent_memories

# ── Agent identity ────────────────────────────────────────────────────────────
# Scopes all memories — change to any string for a separate user profile
AGENT_USER_ID=default_user
